{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mouser",
  "version": "0.2.8",
  "identifier": "com.mouser.app",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Mouser",
        "url": "index.html",
        "visible": false,
        "resizable": true,
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "updater": {
      "dangerousInsecureTransportProtocol": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3NTIwRUQyNkVDMEY1NkUKUldSdTljQnUwZzVTMTJXeWNXZDRXOTZEUGxhS2VVN2J2VzZDZEc2cUl0YThnZGdDekt5dUxCbE4K"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Share one mouse and keyboard across your computers",
    "longDescription": "Mouser lets one mouse and keyboard control several computers on your network, with a shared clipboard.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": { "desktopTemplate": "linux/com.mouser.app.desktop" }
    }
  }
}
