{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mouser.local/schemas/log-bundle.v1.json",
  "title": "Mouser desk log bundle manifest (bundle.json)",
  "type": "object",
  "required": ["created_at", "requested_by", "desk", "computers"],
  "additionalProperties": false,
  "properties": {
    "created_at": { "type": "string", "format": "date-time" },
    "requested_by": { "$ref": "#/$defs/id" },
    "desk": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "required": ["id", "name"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string" } } }
      ]
    },
    "computers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "os", "version", "connection", "included", "folder", "files"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string" },
          "os": { "enum": ["macos", "windows", "linux"] },
          "os_version": { "type": "string" },
          "version": { "type": "string" },
          "mode": { "enum": ["installed", "portable", "portable_elevated", "service", "headless"] },
          "connection": { "enum": ["self", "connected", "reconnecting", "offline", "incompatible"] },
          "included": { "type": "boolean" },
          "reason": { "enum": ["offline", "logging_off", "older_version"] },
          "folder": { "type": "string" },
          "settings_file": { "type": "string" },
          "files": { "type": "array", "items": { "enum": ["mouser.log", "mouser.log.1", "service.log"] } }
        },
        "if": { "properties": { "included": { "const": false } } },
        "then": { "required": ["reason"] }
      }
    }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[0-9a-f]{32}$" } }
}
