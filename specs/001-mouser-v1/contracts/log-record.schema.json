{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mouser.local/schemas/log-record.v1.json",
  "title": "Mouser diagnostic log record (one per line)",
  "type": "object",
  "required": ["ts", "level", "computer", "event"],
  "properties": {
    "ts": { "type": "string", "format": "date-time" },
    "level": { "enum": ["error", "warn", "info", "debug", "trace"] },
    "computer": {
      "type": "object",
      "required": ["id", "name"],
      "properties": { "id": { "type": "string", "pattern": "^[0-9a-f]{32}$" }, "name": { "type": "string" } }
    },
    "event": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$" },
    "peer": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "fields": { "type": "object" }
  },
  "additionalProperties": false
}
