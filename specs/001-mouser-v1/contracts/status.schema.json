{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mouser.local/schemas/status.v1.json",
  "title": "Mouser status (control-api `status`, `mouser status --json`)",
  "type": "object",
  "required": ["version", "computer", "state", "desk", "computers", "problems"],
  "properties": {
    "version": { "type": "string" },
    "computer": { "$ref": "#/$defs/computerRef" },
    "state": { "enum": ["active", "paused"] },
    "desk": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["id", "name"],
          "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "pending_join": { "type": "boolean" } }
        }
      ]
    },
    "active_computer": { "type": ["string", "null"] },
    "computers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "os", "version", "connection", "permissions", "displays"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "os": { "enum": ["macos", "windows", "linux"] },
          "version": { "type": "string" },
          "connection": { "enum": ["self", "connected", "reconnecting", "offline", "incompatible"] },
          "rtt_ms": { "type": ["number", "null"] },
          "last_seen": { "type": ["string", "null"], "format": "date-time" },
          "permissions": { "type": "object", "additionalProperties": { "enum": ["granted", "missing", "not_applicable"] } },
          "limitations": { "type": "array", "items": { "type": "string" } },
          "displays": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "computer", "message"],
        "properties": {
          "kind": { "enum": ["missing_permission", "incompatible_version", "join_refused", "secure_input", "crossing_blocked", "peer_offline", "platform_limitation"] },
          "computer": { "type": "string" },
          "message": { "type": "string" },
          "fix": { "type": ["string", "null"] }
        }
      }
    },
    "logging": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "path": { "type": "string" } } }
  },
  "$defs": { "computerRef": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" } } } }
}
