{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mouser.local/schemas/log-events.v2.json",
  "title": "Mouser diagnostic log record with per-event closed fields (v2). Wraps log-record.v1 (unchanged) and constrains `fields` by `event`.",
  "allOf": [
    { "$ref": "https://mouser.local/schemas/log-record.v1.json" },
    {
      "oneOf": [
        { "$ref": "#/$defs/ev", "properties": { "event": { "const": "log.header" }, "fields": { "type": "object", "required": ["mouser_version", "os", "os_version", "computer_id", "computer_name", "mode", "log_path"], "properties": { "mouser_version": {"type":"string"}, "os": {"enum":["macos","windows","linux"]}, "os_version": {"type":"string"}, "computer_id": {"$ref":"#/$defs/id"}, "computer_name": {"type":"string"}, "desk_id": {"$ref":"#/$defs/id"}, "desk_name": {"type":"string"}, "mode": {"$ref":"#/$defs/mode"}, "log_path": {"type":"string"} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "enum": ["logging.enabled", "logging.disabled"] }, "fields": { "type": "object", "properties": { "path": {"type":"string"} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "const": "control.changed" }, "fields": { "type": "object", "required": ["from", "to", "how"], "properties": { "from": {"$ref":"#/$defs/id"}, "to": {"$ref":"#/$defs/id"}, "how": {"enum":["crossing","panic","quickjump","pause","link_lost","capture_lost","elevated_app","fault","quit","entered"]}, "app": {"$ref":"#/$defs/app"}, "app_admin": {"type":"boolean"} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "const": "pointer.hidden" }, "fields": { "type": "object", "required": ["reason"], "properties": { "reason": {"enum":["crossing_out","quickjump"]} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "const": "pointer.shown" }, "fields": { "type": "object", "required": ["reason"], "properties": { "reason": {"enum":["returned","capture_lost","fault","quit","startup_recovery","guard"]} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "const": "input.refused" }, "fields": { "type": "object", "required": ["kind"], "properties": { "kind": {"$ref":"#/$defs/inputKind"}, "app": {"$ref":"#/$defs/app"}, "app_admin": {"type":"boolean"} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "const": "input.refused_run_ended" }, "fields": { "type": "object", "required": ["kind", "count"], "properties": { "kind": {"$ref":"#/$defs/inputKind"}, "count": {"type":"integer","minimum":1} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "const": "peer.connected" }, "fields": { "type": "object", "properties": { "version": {"type":"string"}, "os": {"enum":["macos","windows","linux"]} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "const": "peer.disconnected" }, "fields": { "type": "object", "required": ["reason"], "properties": { "reason": {"enum":["peer_left","peer_quit","removed","replaced","unreachable","incompatible","protocol","fault_here","quit_here"]} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "const": "wire.unknown" }, "fields": { "type": "object", "required": ["variant"], "properties": { "variant": {"type":"integer","minimum":0} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "const": "fault" }, "fields": { "type": "object", "required": ["where", "location", "message"], "properties": { "where": {"type":"string"}, "location": {"type":"string","pattern":"^[^:]+:[0-9]+$"}, "message": {"type":"string"} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "const": "fault.recovered" }, "fields": { "type": "object", "required": ["where", "action"], "properties": { "where": {"type":"string"}, "action": {"enum":["returned_local","closed_link","continued"]} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "const": "display.changed" }, "fields": { "type": "object", "required": ["computer", "display", "change"], "properties": { "computer": {"$ref":"#/$defs/id"}, "display": {"type":"string"}, "change": {"enum":["added","removed","rearranged","resized"]} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "const": "layout.changed" }, "fields": { "type": "object", "required": ["by", "computer", "change"], "properties": { "by": {"$ref":"#/$defs/id"}, "computer": {"$ref":"#/$defs/id"}, "change": {"enum":["moved","display_removed","display_included","kept_placement","auto_placed"]} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "const": "setting.changed" }, "fields": { "type": "object", "required": ["key", "old", "new", "origin"], "properties": { "key": {"type":"string"}, "old": {}, "new": {}, "origin": {"enum":["app","cli","file","desk_mate"]}, "from": {"$ref":"#/$defs/id"} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "enum": ["clipboard.sent", "clipboard.received"] }, "fields": { "type": "object", "required": ["from", "to", "reps"], "properties": { "from": {"$ref":"#/$defs/id"}, "to": {"$ref":"#/$defs/id"}, "reps": {"type":"array","items":{"type":"object","required":["kind","size"],"properties":{"kind":{"enum":["text","html","rtf","png","files"]},"size":{"type":"integer","minimum":0}},"additionalProperties":false}} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "const": "logs.collected" }, "fields": { "type": "object", "required": ["path", "included", "missing"], "properties": { "path": {"type":"string"}, "included": {"type":"integer","minimum":0}, "missing": {"type":"array","items":{"type":"object","required":["computer","reason"],"properties":{"computer":{"$ref":"#/$defs/id"},"reason":{"enum":["offline","logging_off","older_version"]}},"additionalProperties":false}} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "const": "elevation.restart" }, "fields": { "type": "object", "required": ["outcome"], "properties": { "outcome": {"enum":["prompted","declined","handed_over"]} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "enum": ["problem.raised", "problem.cleared"] }, "fields": { "type": "object", "required": ["kind", "problem_id"], "properties": { "kind": {"type":"string"}, "problem_id": {"type":"string"}, "computer": {"$ref":"#/$defs/id"}, "message": {"type":"string"} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "pattern": "^(config\\.rejected|update\\.[a-z_]+)$" } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "pattern": "^capture\\.(probe|reinstall|hook_thread|start)$" }, "fields": { "type": "object", "properties": { "outcome": {"enum":["seen","unseen","late","missed","skipped","not_sent","live"]}, "reason": {"type":"string"}, "hook": {"enum":["mouse","keyboard"]}, "misses": {"type":"integer"}, "foreground": {"$ref":"#/$defs/app"}, "ok": {"type":"boolean"}, "time_critical": {"type":"boolean"}, "unthrottled": {"type":"boolean"} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "const": "capture.lost" }, "fields": { "type": "object", "required": ["reason"], "properties": { "reason": {"enum":["elevated_foreground","other_desktop","hooks_silent"]}, "foreground": {"$ref":"#/$defs/app"} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "const": "capture.desktop" }, "fields": { "type": "object", "required": ["desktop"], "properties": { "desktop": {"enum":["default","winlogon","other"]} }, "additionalProperties": false } } },
        { "$ref": "#/$defs/ev", "properties": { "event": { "pattern": "^service\\.(session|engine_started|engine_exited|sas)$" }, "fields": { "type": "object", "properties": { "session": {"type":"integer"}, "pid": {"type":"integer"}, "code": {"type":"integer"}, "result": {"enum":["sent","policy_blocked","failed"]} }, "additionalProperties": false } } }
      ]
    }
  ],
  "$defs": {
    "ev": { "type": "object" },
    "id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "app": { "type": "string", "pattern": "^[^\\\\/]+$", "description": "Executable name only; never a path or window title." },
    "mode": { "enum": ["installed", "portable", "portable_elevated", "service", "headless"] },
    "inputKind": { "enum": ["key", "button", "motion", "scroll", "grab", "warp"] }
  }
}
